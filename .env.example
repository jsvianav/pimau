# Copie este archivo como .env y ajuste los valores.
POSTGRES_DB=pimau
POSTGRES_USER=pimau
POSTGRES_PASSWORD=cambiar_esta_clave
DATABASE_URL=postgresql+psycopg://pimau:cambiar_esta_clave@db:5432/pimau
# Secreto para firmar las sesiones del administrador. Genere uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
# Clave gratuita de OpenAQ (pendiente, ver docs/bitacora.md)
OPENAQ_API_KEY=
